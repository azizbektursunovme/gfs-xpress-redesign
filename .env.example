# Where each form sends its JSON (agree on these with the backend developer).
# Leave a value empty to keep that form in preview mode: nothing is sent anywhere.
PUBLIC_QUOTE_ENDPOINT=
PUBLIC_CARRIER_ENDPOINT=
PUBLIC_PORTAL_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=

# "Track Shipment": the TMS tracking page. The reference number is added as ?ref=<number>.
# Empty = the tracking page asks the visitor to call dispatch (no made-up status).
PUBLIC_TRACK_URL=

# "Request Login": the portal sign-in page. Empty = only the "request a login" form is shown.
PUBLIC_PORTAL_URL=

# Canonical/og:url origin. Defaults to https://gfs-xpress.com (never gfs-express.com).
PUBLIC_CANONICAL_ORIGIN=

# "true" adds <meta name="robots" content="noindex"> (used for the GitHub Pages preview).
PUBLIC_NOINDEX=
