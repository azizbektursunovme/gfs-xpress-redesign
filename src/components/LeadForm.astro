---
// One form shell for every form on the site (quote, carrier setup, login request, contact).
// It POSTs the fields as JSON to `endpoint` (agree on it with the backend developer) and shows
// "sent" only after the server answers 2xx. With no endpoint it runs in preview mode and sends nothing.
// Preview a state with ?state=error or ?state=sending.
// Fields go in the default slot. An input's data-msg is its error message; an empty <p id="<input id>-err">
// right after it shows the message.
import Icon from './Icon.astro';
import { company } from '../data/site';
import { url } from '../lib/url';

interface Props {
  id: string;
  endpoint: string;
  source: string;
  submitLabel: string;
  sendingLabel: string;
  successTitle: string;
  successText: string;
  replyNote?: string;
  /** Section heading for screen readers when the page has no visible h2 above the form. */
  title?: string;
}
const { id, endpoint, source, submitLabel, sendingLabel, successTitle, successText, replyNote = 'We reply by phone or email.', title } = Astro.props;
---
<div class="lead quote-card" id={id} data-endpoint={endpoint} data-source={source} data-submit={submitLabel} data-sending={sendingLabel}>
  {title && <h2 class="sr-only">{title}</h2>}
  {!endpoint && (
    <p class="form-note" data-role="preview-banner">
      <Icon name="info" />
      <span><strong>Preview mode.</strong> This form is not connected to a server yet, so nothing you type is sent.</span>
    </p>
  )}

  <form class="form" novalidate>
    <div class="alert alert--error" data-role="error" role="alert" tabindex="-1" hidden>
      <strong>Your request was not sent.</strong>
      <span>Check your connection and try again, or call us at <a href={company.phoneHref}>{company.phone}</a>.</span>
    </div>

    <slot />

    <div class="step step--send">
      <p class="hint">By sending this form you agree to our <a href={url('privacy/')}>Privacy Policy</a> and <a href={url('terms/')}>Terms of Service</a>.</p>
      <div class="form-actions">
        <button class="btn btn--primary btn--lg" type="submit">{submitLabel}</button>
        <p class="hint">{replyNote}</p>
        <span class="sr-only" data-role="status" aria-live="polite"></span>
      </div>
    </div>
  </form>

  <div class="success" data-role="success" hidden>
    <span class="success__icon"><Icon name="check" /></span>
    <h3 tabindex="-1" data-role="success-title">{successTitle}</h3>
    <p>{successText} Questions now? Call <a href={company.phoneHref}>{company.phone}</a>.</p>
    <p class="hint" data-role="success-preview" hidden>Preview mode: nothing was actually sent.</p>
  </div>
</div>

<script>
  const forced = new URLSearchParams(location.search).get('state');

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.lead'))) {
    const form = root.querySelector('form')!;
    const pick = (role: string) => root.querySelector<HTMLElement>(`[data-role="${role}"]`);
    const endpoint = root.dataset.endpoint || '';
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = pick('status')!;
    const errorBox = pick('error')!;
    const success = pick('success')!;
    const successTitle = pick('success-title')!;
    const successPreview = pick('success-preview')!;
    const previewBanner = pick('preview-banner');

    const fields = () => Array.from(form.querySelectorAll<HTMLInputElement>('input.input, textarea.input, select.input'));
    const slotFor = (el: HTMLElement) => (el.id ? document.getElementById(`${el.id}-err`) : null);

    const validate = () => {
      let first: HTMLInputElement | null = null;
      for (const el of fields()) {
        const blank = el.required && !el.value.trim();
        const slot = slotFor(el);
        if (!blank && el.checkValidity()) { el.removeAttribute('aria-invalid'); if (slot) slot.textContent = ''; continue; }
        el.setAttribute('aria-invalid', 'true');
        if (slot) slot.textContent = el.dataset.msg || 'Check this field.';
        first ??= el;
      }
      first?.focus();
      return !first;
    };

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity() && el.value.trim()) {
        el.removeAttribute('aria-invalid');
        const slot = slotFor(el); if (slot) slot.textContent = '';
      }
    });

    const setSending = (on: boolean) => {
      submit.disabled = on;
      submit.textContent = on ? root.dataset.sending! : root.dataset.submit!;
      form.setAttribute('aria-busy', String(on));
      status.textContent = on ? 'Sending.' : '';
    };

    // Resolves only when the server confirms (2xx). Anything else, or 15 s without an answer, is an error.
    const send = async (payload: Record<string, unknown>) => {
      if (!endpoint) {
        if (forced === 'sending') return new Promise<void>(() => {});
        await new Promise((r) => setTimeout(r, 900));
        if (forced === 'error') throw new Error('preview error');
        return;
      }
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 15000);
      try {
        const res = await fetch(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload), signal: ctrl.signal,
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
      } finally { clearTimeout(timer); }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      if (!validate()) return;
      const data: Record<string, unknown> = {};
      new FormData(form).forEach((v, k) => { data[k] = typeof v === 'string' ? v.trim() || null : null; });
      const payload = { ...data, source: root.dataset.source, page: location.pathname, submittedAt: new Date().toISOString() };
      setSending(true);
      try {
        await send(payload);
        successPreview.hidden = Boolean(endpoint);
        form.hidden = true;
        if (previewBanner) previewBanner.hidden = true;
        success.hidden = false;
        successTitle.focus();
        root.dispatchEvent(new CustomEvent('lead:sent'));
      } catch {
        errorBox.hidden = false;
        errorBox.focus();
      } finally {
        setSending(false);
      }
    });
  }
</script>
