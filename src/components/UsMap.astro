---
// Real map of the 48 contiguous states (data: src/data/us-map.json, built by scripts/build-us-map.mjs).
// All 48 states are served; the home state is red and a pin marks the St. Louis headquarters.
import map from '../data/us-map.json';
import { company } from '../data/site';

const served = map.states.length;
const cls = (abbr: string) => (abbr === company.state ? 'usmap__state usmap__state--hq' : 'usmap__state');
const { x, y } = map.hq;
---
<figure class="usmap">
  <svg viewBox={map.viewBox} role="img" aria-labelledby="usmap-title">
    <title id="usmap-title">Map of the {served} contiguous states we serve, with our headquarters in {company.city}, {company.stateName}</title>
    <g>
      {map.states.map((s) => (
        <path class={cls(s.abbr)} d={s.d}><title>{s.name}</title></path>
      ))}
    </g>
    <g class="usmap__pin" transform={`translate(${x} ${y})`} aria-hidden="true">
      <circle class="usmap__ring" r="15" />
      <circle class="usmap__dot" r="6" />
      <text class="usmap__label" x="22" y="-14">{company.city}, {company.state}</text>
    </g>
  </svg>
  <figcaption>
    <ul class="map-key">
      <li><i aria-hidden="true"></i>Served ({served} states)</li>
      <li><i class="key-hq" aria-hidden="true"></i>Headquarters: {company.city}, {company.state}</li>
    </ul>
  </figcaption>
</figure>
