---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CarrierForm from '../components/CarrierForm.astro';
import { company, carrierBenefits, carrierSteps, carrierRequirements, carrierFaq, regions } from '../data/site';
import { url } from '../lib/url';
---
<Base
  title="For carriers: consistent loads and quick pay | GFS Express"
  description="Haul with GFS Express: recurring lanes, clear rates, quick pay and 24/7 dispatch. Carrier setup in about 24 to 48 hours with your MC/DOT, insurance and W-9."
  current="carriers"
>
  <section class="page-hero">
    <Photo name="band-carriers" widths={[800, 1440]} sizes="100vw" width={1440} height={810} alt="" eager />
    <div class="wrap page-hero__inner">
      <h1>Haul with a broker who respects the road</h1>
      <p class="lede">Consistent loads, fair rates, quick pay and a carrier rep who treats you like a partner.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#apply">Start carrier setup</a>
        <a class="btn btn--light" href={url('loads/')}>See the load board</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="why-title">Why carriers choose us</h2>
        <p>Carriers are the backbone of freight. We pay fairly, keep you loaded and pick up the phone.</p>
      </div>
      <ul class="features features--3">
        {carrierBenefits.map((b) => (
          <li class="feature">
            <span class="feature__icon"><Icon name={b.icon} /></span>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="setup-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="setup-title">Start hauling in three steps</h2>
        <p>From application to your first load in as little as 24 to 48 hours.</p>
      </div>
      <ol class="process process--3">
        {carrierSteps.map((s) => <li><h3>{s.title}</h3><p>{s.body}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="lanes-title">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="lanes-title">What you need</h2>
        <ul class="checks">
          {carrierRequirements.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div class="split__copy">
        <h2>Main freight corridors</h2>
        <ul class="checks">
          {regions.map((r) => <li><strong>{r.name}:</strong> {r.states.join(', ')}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="apply" aria-labelledby="apply-title">
    <div class="wrap form-layout">
      <div>
        <div class="head-split" style="grid-template-columns:1fr;margin-bottom:24px">
          <h2 id="apply-title">Carrier setup</h2>
          <p>Send your company details. Our carrier team calls you to finish setup and collects your insurance certificate and W-9.</p>
        </div>
        <CarrierForm />
      </div>
      <aside class="dispatch-card" aria-labelledby="carrier-help-title">
        <div>
          <h2 id="carrier-help-title">Carrier team</h2>
          <p>Questions about setup, loads or payments? Call any time.</p>
        </div>
        <a class="dispatch-card__phone" href={company.phoneHref}><span class="dispatch-card__icon"><Icon name="phone" /></span>{company.phone}</a>
        <ul class="dispatch-list">
          <li><Icon name="mail" /><div><span>Email</span><a href={`mailto:${company.email}`}>{company.email}</a></div></li>
          <li><Icon name="clock" /><div><span>Dispatch</span><strong>24/7</strong></div></li>
        </ul>
        <p class="dispatch-card__note">Already set up? <a href={url('portal/')}>Request a portal login</a>.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="faq-title">Carrier questions</h2>
        <p>Something else? Call <a href={company.phoneHref}>{company.phone}</a>.</p>
      </div>
      <div class="faq">
        {carrierFaq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</Base>
